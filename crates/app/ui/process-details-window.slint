import { Button, Palette, ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HeaderCell } from "process-page.slint";

// 线程的一行（#90）。
export struct ThreadRow { tid: string, priority: string, state: string, cpu: string, start: string, switches: string }

// 句柄的一行（#91）。
export struct HandleRow { kind: string, name: string, value: string, access: string }

// 已加载模块的一行（#74）。
export struct ModuleRow { name: string, path: string, base: string, size: string, description: string, company: string }

// 进程详情窗口（#74）：顶部页签：模块（#74）、线程（#90）、句柄（#91）。
// 数据由 Rust 在窗口打开期间定时刷新（见 controller/process_details.rs）。
export component ProcessDetailsWindow inherits Window {
    title: @tr("进程详细信息");
    min-width: 640px;
    min-height: 320px;
    preferred-width: 960px;
    preferred-height: 560px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    background: Theme.surface;

    // 标题行：进程名与 PID。
    in property <string> heading;
    in property <[ModuleRow]> modules;
    in property <[ThreadRow]> threads;
    in property <[HandleRow]> handles;
    // 句柄页签的类型过滤（子串，不区分大小写）。
    in-out property <string> filter;
    callback filter-changed();
    // 读取失败的原因；空表示正常。needs-elevation 时再显示“以管理员身份重启”。
    in property <string> error;
    in property <bool> needs-elevation;
    in property <string> summary;
    in-out property <int> tab: 0;
    // 各列宽度：0 名称，1 基址，2 大小，3 描述，4 公司（路径占剩余宽度）。
    in-out property <[length]> widths: [180px, 130px, 90px, 200px, 160px];
    callback elevate();
    callback resized-column();
    // 切换页签后由 Rust 立刻读取该页签的数据。
    callback tab-changed();

    public function set-theme(mode: int) {
        Palette.color-scheme = mode == 1 ? ColorScheme.light : mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 12px;
                Text { text: root.heading; vertical-alignment: center; font-size: 15px; font-weight: 600; color: Palette.foreground; overflow: elide; }
                Text { text: root.summary; vertical-alignment: center; color: Theme.subtle-text; horizontal-stretch: 1; horizontal-alignment: right; }
            }
        }
        // 页签头。
        Rectangle {
            height: 34px;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 8px; spacing: 4px; alignment: start;
                for name[i] in [@tr("模块"), @tr("线程"), @tr("句柄")]: Rectangle {
                    width: 72px;
                    border-radius: 4px;
                    background: root.tab == i ? Theme.selected : tab-touch.has-hover ? Theme.hover : transparent;
                    Text { text: name; horizontal-alignment: center; vertical-alignment: center; color: Palette.foreground; }
                    tab-touch := TouchArea { clicked => { if (root.tab != i) { root.tab = i; root.tab-changed(); } } }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.divider; }
        if root.error != "": Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center; spacing: 12px; padding: 24px;
                Text { text: root.error; horizontal-alignment: center; wrap: word-wrap; color: Palette.foreground; }
                if root.needs-elevation: HorizontalLayout {
                    alignment: center;
                    Button { text: @tr("以管理员身份重启"); clicked => { root.elevate(); } }
                }
            }
        }
        if root.error == "" && root.tab == 2: VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding: 6px; padding-left: 8px; padding-right: 8px; alignment: start;
                    LineEdit {
                        width: 240px;
                        placeholder-text: @tr("按类型过滤，如 File、Key、Event");
                        text <=> root.filter;
                        edited => { root.filter-changed(); }
                    }
                }
            }
            Rectangle {
                height: 30px;
                background: Theme.surface-raised;
                HorizontalLayout {
                    padding-left: 8px; spacing: 8px;
                    HeaderCell { text: @tr("类型"); width: 150px; align: left; resizable: false; }
                    HeaderCell { text: @tr("名称"); min-width: 200px; horizontal-stretch: 1; align: left; resizable: false; }
                    HeaderCell { text: @tr("句柄值"); width: 100px; align: left; resizable: false; }
                    HeaderCell { text: @tr("访问掩码"); width: 110px; align: left; resizable: false; }
                }
            }
            ListView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                for row in root.handles: Rectangle {
                    height: Theme.row-height;
                    background: handle-touch.has-hover ? Theme.hover : transparent;
                    handle-touch := TouchArea { }
                    HorizontalLayout {
                        padding-left: 8px; spacing: 8px;
                        Text { width: 150px; text: row.kind; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { min-width: 200px; horizontal-stretch: 1; text: row.name; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: 100px; text: row.value; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: 110px; text: row.access; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                    }
                }
            }
        }
        if root.error == "" && root.tab == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            Rectangle {
                height: 30px;
                background: Theme.surface-raised;
                HorizontalLayout {
                    padding-left: 8px; spacing: 8px;
                    HeaderCell { text: @tr("线程 ID"); width: 80px; align: left; resizable: false; }
                    HeaderCell { text: @tr("优先级"); width: 80px; align: left; resizable: false; }
                    HeaderCell { text: @tr("状态"); width: 190px; align: left; resizable: false; }
                    HeaderCell { text: @tr("CPU 时间"); width: 110px; align: left; resizable: false; }
                    HeaderCell { text: @tr("起始地址"); min-width: 200px; horizontal-stretch: 1; align: left; resizable: false; }
                    HeaderCell { text: @tr("上下文切换"); width: 100px; align: left; resizable: false; }
                }
            }
            ListView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                for row in root.threads: Rectangle {
                    height: Theme.row-height;
                    background: thread-touch.has-hover ? Theme.hover : transparent;
                    thread-touch := TouchArea { }
                    HorizontalLayout {
                        padding-left: 8px; spacing: 8px;
                        Text { width: 80px; text: row.tid; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: 80px; text: row.priority; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: 190px; text: row.state; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: 110px; text: row.cpu; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { min-width: 200px; horizontal-stretch: 1; text: row.start; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: 100px; text: row.switches; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                    }
                }
            }
        }
        if root.error == "" && root.tab == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            Rectangle {
                height: 30px;
                background: Theme.surface-raised;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 0px; spacing: 8px;
                    HeaderCell { text: @tr("名称"); width: root.widths[0]; align: left; resize(w) => { root.widths[0] = max(60px, w); root.resized-column(); } }
                    HeaderCell { text: @tr("路径"); min-width: 160px; horizontal-stretch: 1; align: left; resizable: false; }
                    HeaderCell { text: @tr("基址"); width: root.widths[1]; align: left; resize(w) => { root.widths[1] = max(60px, w); root.resized-column(); } }
                    HeaderCell { text: @tr("大小"); width: root.widths[2]; align: left; resize(w) => { root.widths[2] = max(50px, w); root.resized-column(); } }
                    HeaderCell { text: @tr("描述"); width: root.widths[3]; align: left; resize(w) => { root.widths[3] = max(60px, w); root.resized-column(); } }
                    HeaderCell { text: @tr("公司"); width: root.widths[4]; align: left; resize(w) => { root.widths[4] = max(60px, w); root.resized-column(); } }
                }
            }
            ListView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                for row in root.modules: Rectangle {
                    height: Theme.row-height;
                    background: touch.has-hover ? Theme.hover : transparent;
                    touch := TouchArea { }
                    HorizontalLayout {
                        padding-left: 8px; spacing: 8px;
                        Text { width: root.widths[0]; text: row.name; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { min-width: 160px; horizontal-stretch: 1; text: row.path; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: root.widths[1]; text: row.base; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: root.widths[2]; text: row.size; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: root.widths[3]; text: row.description; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                        Text { width: root.widths[4]; text: row.company; overflow: elide; vertical-alignment: center; color: Palette.foreground; }
                    }
                }
            }
        }
    }
}
