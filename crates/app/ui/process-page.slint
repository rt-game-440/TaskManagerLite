import { ListView, Palette } from "std-widgets.slint";
import { Theme, Chevron } from "theme.slint";
import { ColumnLayout, DetailChoice, DetailHeader, ProcRow } from "types.slint";

// 列宽：名称列伸缩，其余由用户拖动调整（启动时由设置恢复，默认值与 settings.rs 保持一致）。
export global Columns {
    in-out property <length> pid: 76px;
    in-out property <length> cpu: 76px;
    in-out property <length> memory: 108px;
    in-out property <length> disk: 108px;
    // 进程磁盘速率是否来自 ETW 磁盘事件（准确）；否则是近似值，列头显示“≈”。
    in-out property <bool> disk-accurate: false;
    // 基本列的标题：表头与“导出为 CSV”的表头共用这一份文字（Rust 侧读取，见 controller/export.rs）。
    out property <string> title-name: @tr("名称");
    out property <string> title-pid: @tr("PID");
    out property <string> title-cpu: @tr("CPU");
    out property <string> title-memory: @tr("内存");
    out property <string> title-disk: self.disk-accurate ? @tr("磁盘") : @tr("磁盘 ≈");
    // 表头上行的整机占用（#96，由 Rust 每次完整采样更新；口径见 GLOSSARY.md“表头总占用”）。
    // 只写进表头，不进 CSV 导出的列标题。
    in-out property <string> total-cpu;
    in-out property <string> total-memory;
    in-out property <string> total-disk;
    in-out property <string> total-gpu;
    in-out property <string> total-network;
    out property <length> default-pid: 76px;
    out property <length> default-cpu: 76px;
    out property <length> default-memory: 108px;
    out property <length> default-disk: 108px;
    out property <length> min: 48px;
    // 上限与 settings.rs 的 `ColumnWidths::MAX` 一致；默认布局等分后的宽度可能较大，冻结时不能被截断。
    out property <length> max: 1200px;
    // “详细信息”列的宽度范围，与 details.rs 的 MIN_WIDTH / MAX_WIDTH 保持一致。
    out property <length> detail-min: 40px;
    out property <length> detail-max: 1200px;
    // 名称列至少保留的宽度；上面的 pid/cpu/... 是用户设定值，实际显示用 `eff`：
    // 列宽总和超出可用宽度时按比例缩小（算法在 Rust 侧，见 settings.rs 的 `ColumnWidths::fit`），设定值不变。
    out property <length> name-min: 180px;
    // 名称列宽度：0 表示自动填满（默认）；拖过表头分隔线后固定，此后表格左对齐，
    // 放不下就横向滚动、放得下右侧留空。范围与 settings.rs 的 NAME_WIDTH_MIN / MAX 一致。
    in-out property <length> name: 0px;
    out property <length> name-fixed-min: 100px;
    out property <length> name-fixed-max: 1200px;
    // 列表可用于各列的宽度，由 ProcessPage 随窗口宽度更新。
    in-out property <length> available;
    pure callback fit(length, length, length, length, length, length) -> ColumnLayout;
    // PID 列是否显示（默认隐藏，表头右键菜单切换；由 Rust 从设置恢复与保存）。
    in-out property <bool> show-pid: false;
    // GPU 列在显示中的“详细信息”列里的位置（-1 未显示）与保存的宽度（由 Rust 维护）。
    in-out property <int> gpu-index: -1;
    in-out property <length> gpu-stored: 0px;

    // 默认布局（name == 0，首次启动、双击名称列分隔线或“恢复默认列”后）：名称列取默认宽度，
    // CPU、内存、磁盘、GPU（显示时）等宽并撑满其余宽度；PID 与其他详细列保持各自宽度。
    // 拖动任一分隔线后整体固化为固定宽度（见 ProcessPage.freeze），此后放不下就横向滚动、放得下右侧留空。
    out property <bool> auto: self.name <= 0;
    out property <length> name-default: 300px;
    property <length> pid-clamped: Math.max(self.min, Math.min(self.max, self.pid));
    property <int> share-count: self.gpu-index >= 0 ? 4 : 3;
    // 默认布局下不参与等分的列宽之和。
    property <length> fixed-others: (self.show-pid ? self.pid-clamped : 0px) + self.extra-total - self.gpu-stored;
    property <length> name-auto: Math.max(self.name-min, Math.min(self.name-default, self.available - self.fixed-others - self.share-count * self.default-cpu));
    out property <length> share: Math.max(self.min, (self.available - self.name-auto - self.fixed-others) / self.share-count);
    out property <ColumnLayout> eff: self.auto
        ? { pid: self.pid-clamped, cpu: self.share, memory: self.share, disk: self.share }
        : self.fit(100000px, self.name-min, self.pid, self.cpu, self.memory, self.disk);
    out property <length> pid-eff: self.show-pid ? self.eff.pid : 0px;
    out property <length> name-eff: self.auto ? self.name-auto : self.name;
    // 详细列实际宽度之和（默认布局下 GPU 列取等分宽度）。
    out property <length> extra-eff: self.auto && self.gpu-index >= 0 ? self.extra-total - self.gpu-stored + self.share : self.extra-total;

    // 第 i 个详细列的实际宽度。
    public pure function extra-width(i: int, w: length) -> length {
        self.auto && i == self.gpu-index ? self.share : w
    }

    // “详细信息”列（由 Rust 维护）：显示中的列及其宽度总和、列选择菜单的选项（全部可选列）。
    in-out property <[DetailHeader]> extra;
    in-out property <length> extra-total;
    in-out property <[DetailChoice]> choices;
    // 参数为可选列的序号（choices 中的下标）。
    callback toggle-detail(int);
    callback reset-details();
    // 把第 i 个显示中的列设为目标宽度（Rust 负责限制范围）；双击分隔线恢复默认宽度。
    callback resize-detail(int, length);
    callback reset-detail-width(int);
}

// 右键菜单的状态与动作：菜单弹出前由 Rust 读取所选进程的路径与命令行，决定各项是否可用。
export global ProcessMenu {
    in-out property <bool> can-open-location;
    in-out property <bool> can-copy-path;
    in-out property <bool> can-copy-command-line;
    in-out property <bool> can-show-properties;
    // “设置优先级”“设置亲和性”：能否修改由 Rust 在菜单弹出前探测（受保护进程、已退出的进程置灰）。
    in-out property <bool> can-set-priority;
    in-out property <bool> can-set-affinity;
    // 当前优先级的序号（0 实时 … 5 低，与 `PriorityClass::index` 一致）；读不到为 -1，不打勾。
    in-out property <int> priority: -1;
    // “效率模式”（#68）：系统不支持（Windows 10 1709 以下）时整项隐藏；系统关键进程、本程序自身与
    // 无权限的进程置灰（标题里带原因）。勾选 = 所选进程当前处于效率模式。
    in-out property <bool> eco-visible;
    in-out property <bool> can-eco;
    in-out property <bool> eco-checked;
    in-out property <string> eco-title;
    in-out property <bool> can-suspend;
    in-out property <bool> can-resume;
    in-out property <string> suspend-title;
    in-out property <string> resume-title;
    // “创建转储文件”（#75）：受保护进程、位数不匹配等置灰（标题里带原因）。
    in-out property <bool> can-dump;
    in-out property <string> dump-title;
    // “转到服务”（#85）：所选进程承载服务时可用，否则置灰（菜单弹出前由 Rust 枚举判断）。
    in-out property <bool> can-goto-service;
    // 应用窗口操作（#70）：只有分组视图的应用行显示；已处于目标状态、窗口已关闭、目标需要提权时置灰（标题里带原因）。
    in-out property <bool> window-visible;
    in-out property <bool> can-window-activate;
    in-out property <bool> can-window-maximize;
    in-out property <bool> can-window-minimize;
    in-out property <bool> can-window-restore;
    in-out property <string> window-activate-title;
    in-out property <string> window-maximize-title;
    in-out property <string> window-minimize-title;
    in-out property <string> window-restore-title;
    callback opening();
    callback open-location();
    callback copy-path();
    callback copy-command-line();
    callback show-properties();
    callback search-online();
    // 复制所选行为制表符分隔的文本（右键菜单与 Ctrl+C）。
    callback copy-row();
    // 导出整个进程列表为 CSV（行右键菜单与表头右键菜单）。
    callback export-csv();
    // 设为第 i 个优先级（序号同 `priority`）；“实时”由 Rust 先弹确认框。
    callback set-priority(int);
    // 打开“设置亲和性”对话框。
    callback set-affinity();
    // 切换所选进程（应用行为其全部后代）的效率模式；多于一个进程时由 Rust 先弹确认框。
    callback toggle-eco();
    // 创建转储文件：false = 最小，true = 完整；保存位置与完整转储的体积确认由 Rust 处理。
    callback create-dump(bool);
    // 打开进程详细信息窗口（#74）。
    callback show-details();
    callback suspend();
    callback resume();
    // 切到服务页，按所选进程的 PID 过滤并选中它承载的服务。
    callback goto-service();
    // 对所选应用行的主窗口操作：0 切换到、1 最大化、2 最小化、3 还原。
    callback window-op(int);
}

export component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> descending;
    in property <TextHorizontalAlignment> align: right;
    in property <bool> resizable: true;
    // 进程页的两行表头（#96）：`total` 为该列的整机占用（如“37%”），空串表示该列没有总量。
    in property <bool> two-line: false;
    in property <string> total;
    callback clicked;
    // 拖动分隔线：参数为本列的目标列宽；双击恢复默认宽度。
    // 分隔线默认在左边缘（向左拖本列变宽）；`grip-right` 时在右边缘，只调本列，向右拖变宽。
    callback resize(length);
    callback reset();
    in property <bool> grip-right: false;
    // 右键按下：参数为指针的窗口坐标，由页面弹出列选择菜单。
    callback context-menu(length, length);

    // 按下分隔线时指针的窗口横坐标与当时的列宽。按指针的绝对位移求目标宽度：
    // 横向滚动时列的左边缘不一定跟随指针移动，按相对按下点的偏移累加会失控。
    property <length> drag-from;
    property <length> drag-width;

    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: root.two-line ? 4px : 0px;
        padding-bottom: root.two-line ? 6px : 0px;
        // 两行表头（进程页，#96）：上行大号整机占用，下行列名；没有总量的列上行留空，列名仍与其他列对齐。
        if root.two-line: HorizontalLayout {
            height: 22px;
            Text {
                horizontal-stretch: 1;
                text: root.total;
                horizontal-alignment: root.align;
                vertical-alignment: bottom;
                font-size: 17px;
                color: Palette.foreground;
                overflow: elide;
            }
            // 右对齐时与下行列名的右缘对齐：让出排序箭头的宽度与间距。
            Rectangle {
                width: root.align == TextHorizontalAlignment.right ? 14px : 0px;
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.text;
                horizontal-stretch: 1;
                horizontal-alignment: root.align;
                vertical-alignment: center;
                font-size: 12px;
                font-weight: root.active ? 600 : 400;
                color: root.active ? Palette.foreground : Theme.subtle-text;
                overflow: elide;
            }

            // 箭头固定 10px 高，直接放进布局会把这一行的最大高度限制成 10px，
            // 单行表头的列名就贴到顶部；套一层不限高的 Rectangle 让这一行撑满表头高度。
            Rectangle {
                width: 10px;
                Chevron {
                    y: (parent.height - self.height) / 2;
                    direction: root.descending ? 0 : 1;
                    stroke: root.active ? Theme.subtle-text : transparent;
                }
            }
        }
    }

    if root.resizable: Rectangle {
        x: root.grip-right ? root.width - 5px : -3px;
        width: 8px;
        Rectangle {
            x: 3px;
            y: 8px;
            width: 1px;
            height: parent.height - 16px;
            background: grip.has-hover || grip.pressed ? Palette.accent-background : Theme.divider;
        }

        grip := TouchArea {
            mouse-cursor: col-resize;
            pointer-event(e) => {
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                    root.drag-from = self.absolute-position.x + self.mouse-x;
                    root.drag-width = root.width;
                }
            }
            moved => {
                if self.pressed {
                    let delta = self.absolute-position.x + self.mouse-x - root.drag-from;
                    root.resize(root.grip-right ? root.drag-width + delta : root.drag-width - delta);
                }
            }
            double-clicked => {
                root.reset();
            }
        }
    }
}

component ValueCell inherits Rectangle {
    in property <string> text;
    in property <float> heat;

    background: Theme.heat.with-alpha(root.heat * (Theme.dark ? 0.32 : 0.42));
    Text {
        x: 10px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.text;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: Palette.foreground;
    }
}

// “详细信息”列的单元格。
component TextCell inherits Rectangle {
    in property <string> text;
    in property <bool> right;

    Text {
        // 右对齐时与数值列一致；左对齐时与表头文字对齐（行整体比表头右移 10px，见 ProcessPage 的 header-padding）。
        x: root.right ? 10px : 0px;
        width: parent.width - (root.right ? 28px : 10px);
        height: parent.height;
        text: root.text;
        horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: center;
        overflow: elide;
        color: Palette.foreground;
    }
}

component ProcRowView inherits Rectangle {
    in property <ProcRow> data;
    in property <bool> selected;
    callback select();
    callback toggle();
    callback end-process();
    callback end-tree();

    height: Theme.row-height;
    background: root.selected ? Theme.selected : root.data.change == 1 ? Theme.row-new : root.data.change == 2 ? Theme.row-exited : touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.data.name;
    accessible-description: root.data.change == 1 ? @tr("新启动")
        : root.data.change == 2 ? @tr("已退出")
        : root.data.kind == 4 ? @tr("关键进程")
        : root.data.kind == 3 ? @tr("已提权")
        : root.data.kind == 2 ? @tr("系统账户")
        : root.data.kind == 1 ? @tr("承载服务") : "";

    menu := ContextMenuArea {
        width: 100%;
        height: 100%;
        Menu {
            if ProcessMenu.window-visible: MenuItem {
                title: ProcessMenu.window-activate-title;
                enabled: ProcessMenu.can-window-activate;
                activated => {
                    root.select();
                    ProcessMenu.window-op(0);
                }
            }

            if ProcessMenu.window-visible: MenuItem {
                title: ProcessMenu.window-maximize-title;
                enabled: ProcessMenu.can-window-maximize;
                activated => {
                    root.select();
                    ProcessMenu.window-op(1);
                }
            }

            if ProcessMenu.window-visible: MenuItem {
                title: ProcessMenu.window-minimize-title;
                enabled: ProcessMenu.can-window-minimize;
                activated => {
                    root.select();
                    ProcessMenu.window-op(2);
                }
            }

            if ProcessMenu.window-visible: MenuItem {
                title: ProcessMenu.window-restore-title;
                enabled: ProcessMenu.can-window-restore;
                activated => {
                    root.select();
                    ProcessMenu.window-op(3);
                }
            }

            if ProcessMenu.window-visible: MenuSeparator {}

            MenuItem {
                title: @tr("结束进程");
                activated => {
                    root.select();
                    root.end-process();
                }
            }

            MenuItem {
                title: @tr("结束进程树");
                activated => {
                    root.select();
                    root.end-tree();
                }
            }

            MenuSeparator {}

            Menu {
                title: @tr("设置优先级");
                MenuItem {
                    title: @tr("实时");
                    checkable: true;
                    checked: ProcessMenu.priority == 0;
                    enabled: ProcessMenu.can-set-priority;
                    activated => {
                        ProcessMenu.set-priority(0);
                    }
                }

                MenuItem {
                    title: @tr("高");
                    checkable: true;
                    checked: ProcessMenu.priority == 1;
                    enabled: ProcessMenu.can-set-priority;
                    activated => {
                        ProcessMenu.set-priority(1);
                    }
                }

                MenuItem {
                    title: @tr("高于正常");
                    checkable: true;
                    checked: ProcessMenu.priority == 2;
                    enabled: ProcessMenu.can-set-priority;
                    activated => {
                        ProcessMenu.set-priority(2);
                    }
                }

                MenuItem {
                    title: @tr("正常");
                    checkable: true;
                    checked: ProcessMenu.priority == 3;
                    enabled: ProcessMenu.can-set-priority;
                    activated => {
                        ProcessMenu.set-priority(3);
                    }
                }

                MenuItem {
                    title: @tr("低于正常");
                    checkable: true;
                    checked: ProcessMenu.priority == 4;
                    enabled: ProcessMenu.can-set-priority;
                    activated => {
                        ProcessMenu.set-priority(4);
                    }
                }

                MenuItem {
                    title: @tr("低");
                    checkable: true;
                    checked: ProcessMenu.priority == 5;
                    enabled: ProcessMenu.can-set-priority;
                    activated => {
                        ProcessMenu.set-priority(5);
                    }
                }
            }

            MenuItem {
                title: @tr("设置亲和性…");
                enabled: ProcessMenu.can-set-affinity;
                activated => {
                    ProcessMenu.set-affinity();
                }
            }

            if ProcessMenu.eco-visible: MenuItem {
                title: ProcessMenu.eco-title;
                checkable: true;
                checked: ProcessMenu.eco-checked;
                enabled: ProcessMenu.can-eco;
                activated => {
                    ProcessMenu.toggle-eco();
                }
            }

            MenuItem {
                title: ProcessMenu.suspend-title;
                enabled: ProcessMenu.can-suspend;
                activated => {
                    ProcessMenu.suspend();
                }
            }

            MenuItem {
                title: ProcessMenu.resume-title;
                enabled: ProcessMenu.can-resume;
                activated => {
                    ProcessMenu.resume();
                }
            }

            Menu {
                title: ProcessMenu.dump-title;
                enabled: ProcessMenu.can-dump;

                MenuItem {
                    title: @tr("最小转储…");
                    enabled: ProcessMenu.can-dump;
                    activated => {
                        ProcessMenu.create-dump(false);
                    }
                }

                MenuItem {
                    title: @tr("完整转储…");
                    enabled: ProcessMenu.can-dump;
                    activated => {
                        ProcessMenu.create-dump(true);
                    }
                }
            }

            MenuItem {
                title: @tr("详细信息…");
                activated => {
                    ProcessMenu.show-details();
                }
            }
            MenuItem {
                title: @tr("转到服务");
                enabled: ProcessMenu.can-goto-service;
                activated => {
                    ProcessMenu.goto-service();
                }
            }

            MenuSeparator {}

            MenuItem {
                title: @tr("打开文件位置");
                enabled: ProcessMenu.can-open-location;
                activated => {
                    ProcessMenu.open-location();
                }
            }

            MenuItem {
                title: @tr("复制路径");
                enabled: ProcessMenu.can-copy-path;
                activated => {
                    ProcessMenu.copy-path();
                }
            }

            MenuItem {
                title: @tr("复制命令行");
                enabled: ProcessMenu.can-copy-command-line;
                activated => {
                    ProcessMenu.copy-command-line();
                }
            }

            MenuItem {
                title: @tr("属性");
                enabled: ProcessMenu.can-show-properties;
                activated => {
                    ProcessMenu.show-properties();
                }
            }

            MenuSeparator {}

            MenuItem {
                title: @tr("在线搜索进程名");
                activated => {
                    ProcessMenu.search-online();
                }
            }

            MenuSeparator {}

            MenuItem {
                title: @tr("复制所选行");
                activated => {
                    ProcessMenu.copy-row();
                }
            }

            MenuItem {
                title: @tr("导出为 CSV…");
                activated => {
                    ProcessMenu.export-csv();
                }
            }
        }

        touch := TouchArea {
            // TouchArea 会吞掉右键，所以由它在右键按下时选中该行、读取菜单状态并弹出菜单。
            pointer-event(e) => {
                // 标题行不弹进程菜单（上面还有一层吞掉事件的覆盖，这里再防一道）。
                if e.button == PointerEventButton.right && e.kind == PointerEventKind.down && !root.data.header {
                    root.select();
                    ProcessMenu.opening();
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
            clicked => {
                root.select();
            }
            double-clicked => {
                if root.data.has-children {
                    root.toggle();
                }
            }
        }
    }

    HorizontalLayout {
        HorizontalLayout {
            width: Columns.name-eff;
            padding-left: 6px + root.data.depth * 18px;
            padding-right: 10px;
            spacing: 4px;

            Rectangle {
                width: 18px;
                expander := TouchArea {
                    enabled: root.data.has-children;
                    // 箭头区域叠在整行的 TouchArea 之上，会吞掉右键，这里同样弹出菜单（坐标换算到整行）。
                    pointer-event(e) => {
                        if e.button == PointerEventButton.right && e.kind == PointerEventKind.down && !root.data.header {
                            root.select();
                            ProcessMenu.opening();
                            menu.show({
                                x: self.absolute-position.x - touch.absolute-position.x + self.mouse-x,
                                y: self.absolute-position.y - touch.absolute-position.y + self.mouse-y,
                            });
                        }
                    }
                    clicked => {
                        root.select();
                        root.toggle();
                    }
                }

                if root.data.has-children: Chevron {
                    direction: root.data.expanded ? 0 : 2;
                    stroke: expander.has-hover ? Palette.foreground : Theme.subtle-text;
                }
            }

            Image {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                source: root.data.icon;
                image-fit: contain;
            }

            Text {
                text: root.data.name;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                color: Palette.foreground;
            }

            if root.data.critical: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 18px;
                width: tag.preferred-width + 12px;
                border-radius: 9px;
                background: Theme.danger.with-alpha(0.14);
                tag := Text {
                    text: @tr("关键");
                    font-size: 11px;
                    color: Theme.danger;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if Columns.show-pid: ValueCell {
            width: Columns.eff.pid;
            text: root.data.pid;
            heat: 0;
        }

        ValueCell {
            width: Columns.eff.cpu;
            text: root.data.cpu;
            heat: root.data.cpu-heat;
        }

        ValueCell {
            width: Columns.eff.memory;
            text: root.data.memory;
            heat: root.data.memory-heat;
        }

        ValueCell {
            width: Columns.eff.disk;
            text: root.data.disk;
            heat: root.data.disk-heat;
        }

        for t[i] in root.data.extra: TextCell {
            width: Columns.extra-width(i, Columns.extra[i].width);
            text: t;
            right: Columns.extra[i].right;
        }

        // 与表头一致：列宽总和小于表格宽度时右侧留空。
        Rectangle {
            horizontal-stretch: 1;
        }
    }

    // 类型色条（#80）：行首 3px，不挡鼠标。
    if root.data.kind > 0 && !root.data.header: Rectangle {
        x: 0;
        width: 3px;
        background: Theme.kind-color(root.data.kind);
    }

    // 分组标题行：盖住整行，吃掉鼠标事件（不可选中、没有右键菜单）。
    if root.data.header: Rectangle {
        background: Theme.surface;
        TouchArea { }

        Rectangle {
            background: Theme.dark ? #ffffff0a : #00000008;
        }

        Text {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text: root.data.name;
            vertical-alignment: center;
            overflow: elide;
            font-size: 12px;
            font-weight: 600;
            color: Theme.subtle-text;
        }
    }
}

export component ProcessPage inherits Rectangle {
    in property <[ProcRow]> rows;
    in property <int> selected;
    in property <int> sort-key;
    in property <bool> sort-descending;
    in property <bool> filtering;
    callback sort-by(int);
    callback select(int);
    callback toggle(int);
    callback end-process();
    callback end-tree();

    // 表头右侧留白；其余宽度交给 Columns 分配。
    property <length> header-padding: 10px;
    // 表格（行与表头）的宽度：放得下所有列时等于页面宽度（名称列自动时填满，固定时右侧留空）；放不下时横向滚动。
    property <length> rows-width: max(root.width, Columns.name-eff + Columns.pid-eff + Columns.eff.cpu + Columns.eff.memory + Columns.eff.disk + Columns.extra-eff + root.header-padding);

    function sync-available() {
        Columns.available = root.width - root.header-padding;
    }

    changed width => {
        root.sync-available();
    }

    init => {
        root.sync-available();
    }

    function show-header-menu(x: length, y: length) {
        header-menu.show({ x: x - header-menu.absolute-position.x, y: y - header-menu.absolute-position.y });
    }

    // 表头分隔线在每列右边缘，只调它左边那一列；右侧各列宽度不变、跟着平移。
    // 列序号：0 名称、1 PID、2 CPU、3 内存、4 磁盘、5+i 第 i 个“详细信息”列。
    function col-min(k: int) -> length {
        k == 0 ? Columns.name-fixed-min : k <= 4 ? Columns.min : Columns.detail-min
    }

    function col-max(k: int) -> length {
        k == 0 ? Columns.name-fixed-max : k <= 4 ? Columns.max : Columns.detail-max
    }

    // 把名称列与基本列当前的有效宽度固化为设定值：名称列从自动填满转为固定宽度，
    // 基本列不再因窗口宽度按比例缩放，之后改一列不会牵动其他列。
    function freeze() {
        if !Columns.auto {
            return;
        }
        let n = Columns.name-eff;
        let e = Columns.eff;
        if Columns.gpu-index >= 0 {
            Columns.resize-detail(Columns.gpu-index, Columns.share);
        }
        Columns.pid = e.pid;
        Columns.cpu = e.cpu;
        Columns.memory = e.memory;
        Columns.disk = e.disk;
        Columns.name = n;
    }

    function resize-col(k: int, target: length) {
        root.freeze();
        root.set-col(k, max(root.col-min(k), min(root.col-max(k), target)));
    }

    function set-col(k: int, w: length) {
        if k == 0 {
            Columns.name = w;
        } else if k == 1 {
            Columns.pid = w;
        } else if k == 2 {
            Columns.cpu = w;
        } else if k == 3 {
            Columns.memory = w;
        } else if k == 4 {
            Columns.disk = w;
        } else {
            Columns.resize-detail(k - 5, w);
        }
    }

    // 双击分隔线：名称列回到自动填满；其他列恢复默认宽度（名称列保持固定，右侧各列平移）。
    function reset-col(k: int) {
        if k == 0 {
            Columns.name = 0px;
            return;
        }
        root.freeze();
        if k == 1 {
            Columns.pid = Columns.default-pid;
        } else if k == 2 {
            Columns.cpu = Columns.default-cpu;
        } else if k == 3 {
            Columns.memory = Columns.default-memory;
        } else if k == 4 {
            Columns.disk = Columns.default-disk;
        } else {
            Columns.reset-detail-width(k - 5);
        }
    }

    // 键盘移动选中行后，让它保持在可视范围内。
    public function ensure-visible(index: int) {
        if index * Theme.row-height + list.content-y < 0 {
            list.content-y = -index * Theme.row-height;
        } else if (index + 1) * Theme.row-height + list.content-y > list.visible-height {
            list.content-y = list.visible-height - (index + 1) * Theme.row-height;
        }
    }

    VerticalLayout {
        Rectangle {
            // 两行表头（#96）：上行整机占用，下行列名。
            height: 52px;
            clip: true;
            // 列选择菜单：在任意列标题上右键弹出（标题的 TouchArea 会吞掉右键，由它们转发坐标）。
            header-menu := ContextMenuArea {
                width: 100%;
                height: 100%;
                Menu {
                    // PID 是基本列，不在 choices 里；勾选状态由菜单自动切换，经双向绑定写回。
                    MenuItem {
                        title: Columns.title-pid;
                        checkable: true;
                        checked <=> Columns.show-pid;
                    }

                    for c[i] in Columns.choices: MenuItem {
                        title: c.title;
                        checkable: true;
                        // 双向绑定：原生菜单激活勾选项时会直接改写 checked，单向绑定会因此失效，之后“恢复默认列”等改动就不再反映到勾选状态上。
                        checked <=> c.shown;
                        activated => {
                            Columns.toggle-detail(i);
                        }
                    }
                    MenuSeparator {}

                    MenuItem {
                        title: @tr("恢复默认列");
                        activated => {
                            Columns.reset-details();
                        }
                    }

                    MenuSeparator {}

                    MenuItem {
                        title: @tr("导出为 CSV…");
                        activated => {
                            ProcessMenu.export-csv();
                        }
                    }
                }
            }

            // 与列表一起横向滚动；显式的 x/width 让表头的尺寸约束不传给页面。
            HorizontalLayout {
                x: list.content-x;
                y: 0px;
                width: root.rows-width;
                height: parent.height;
                padding-right: root.header-padding;
                HeaderCell {
                    two-line: true;
                    width: Columns.name-eff;
                    grip-right: true;
                    resize(d) => {
                        root.resize-col(0, d);
                    }
                    reset => {
                        root.reset-col(0);
                    }
                    text: Columns.title-name;
                    align: left;
                    active: root.sort-key == 0;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort-by(0);
                    }
                    context-menu(x, y) => {
                        root.show-header-menu(x, y);
                    }
                }

                if Columns.show-pid: HeaderCell {
                    two-line: true;
                    width: Columns.eff.pid;
                    grip-right: true;
                    resize(d) => {
                        root.resize-col(1, d);
                    }
                    reset => {
                        root.reset-col(1);
                    }
                    text: Columns.title-pid;
                    active: root.sort-key == 1;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort-by(1);
                    }
                    context-menu(x, y) => {
                        root.show-header-menu(x, y);
                    }
                }

                HeaderCell {
                    two-line: true;
                    total: Columns.total-cpu;
                    width: Columns.eff.cpu;
                    grip-right: true;
                    resize(d) => {
                        root.resize-col(2, d);
                    }
                    reset => {
                        root.reset-col(2);
                    }
                    text: Columns.title-cpu;
                    active: root.sort-key == 2;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort-by(2);
                    }
                    context-menu(x, y) => {
                        root.show-header-menu(x, y);
                    }
                }

                HeaderCell {
                    two-line: true;
                    total: Columns.total-memory;
                    width: Columns.eff.memory;
                    grip-right: true;
                    resize(d) => {
                        root.resize-col(3, d);
                    }
                    reset => {
                        root.reset-col(3);
                    }
                    text: Columns.title-memory;
                    active: root.sort-key == 3;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort-by(3);
                    }
                    context-menu(x, y) => {
                        root.show-header-menu(x, y);
                    }
                }

                HeaderCell {
                    two-line: true;
                    total: Columns.total-disk;
                    width: Columns.eff.disk;
                    grip-right: true;
                    resize(d) => {
                        root.resize-col(4, d);
                    }
                    reset => {
                        root.reset-col(4);
                    }
                    text: Columns.title-disk;
                    active: root.sort-key == 4;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort-by(4);
                    }
                    context-menu(x, y) => {
                        root.show-header-menu(x, y);
                    }
                }

                for c[i] in Columns.extra: HeaderCell {
                    two-line: true;
                    total: c.total == 1 ? Columns.total-gpu : c.total == 2 ? Columns.total-network : "";
                    width: Columns.extra-width(i, c.width);
                    text: c.title;
                    align: c.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    active: root.sort-key == c.sort;
                    descending: root.sort-descending;
                    clicked => {
                        root.sort-by(c.sort);
                    }
                    grip-right: true;
                    resize(w) => {
                        root.resize-col(5 + i, w);
                    }
                    reset => {
                        root.reset-col(5 + i);
                    }
                    context-menu(x, y) => {
                        root.show-header-menu(x, y);
                    }
                }

                // 名称列固定后列宽总和可能小于窗口：右侧留空。
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.divider;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            list := ListView {
                content-width: root.rows-width;
                for row[i] in root.rows: ProcRowView {
                    width: root.rows-width;
                    data: row;
                    selected: i == root.selected;
                    select => {
                        root.select(i);
                    }
                    toggle => {
                        root.toggle(i);
                    }
                    end-process => {
                        root.end-process();
                    }
                    end-tree => {
                        root.end-tree();
                    }
                }
            }

            if root.rows.length == 0 && root.filtering: Text {
                text: @tr("没有匹配的进程");
                color: Theme.subtle-text;
                font-size: 14px;
            }
        }
    }
}
